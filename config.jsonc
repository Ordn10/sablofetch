{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "/~/.config/fastfetch/sablik.png",
    "type": "kitty-direct",
    "width": 34,
    "height": 15,
    "padding": { "top": 1, "left": 2, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 16 },
    "percent": { "type": 3 }
  },

  "modules": [
    // title, centered above the line (7 spaces of padding)
    {
      "type": "title",
      "format": "       {user-name-colored}\u001b[90m 󰁥 \u001b[0m{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "\u001b[90m──────────────────────────────"
    },

    // ── software ──
    { "type": "os",     "key": "╭─ 󰣇  OS",     "keyColor": "magenta" },
    { "type": "kernel", "key": "├─   Kernel", "keyColor": "magenta", "format": "{1} {2}" },
    { "type": "shell",  "key": "╰─   Shell",  "keyColor": "magenta" },

    "break",

    // ── hardware ──
    { "type": "board",   "key": "╭─   Board",           "keyColor": "cyan" },
    { "type": "cpu",     "key": "├─   CPU",             "keyColor": "cyan" },
    { "type": "gpu",     "key": "├─ 󰢮  GPU",       "keyColor": "cyan" },
    { "type": "display", "key": "├─ 󰍹  Display",         "keyColor": "cyan" },
    { "type": "memory",  "key": "├─   Memory",          "keyColor": "cyan" },
    { "type": "swap",    "key": "├─   Swap",            "keyColor": "cyan" },
    {
      // model of your first real drive (ignores zram, loop and LVM devices)
      "type": "command",
      "key": "├─   Drive",
      "keyColor": "cyan",
      "text": "lsblk -dn -o NAME,MODEL,SIZE | grep -Ev '^(zram|loop|sr|ram|dm-)' | head -n1 | tr -s ' ' | cut -d' ' -f2-"
    },
    {
      "type": "disk",
      "key": "├─   Root",
      "keyColor": "cyan",
      "folders": "/",
      "format": "{1} / {2} ({3}) · {9}"
    },
    {
      // shows nothing if /home is not a separate volume
      "type": "disk",
      "key": "├─   Home",
      "keyColor": "cyan",
      "folders": "/home",
      "format": "{1} / {2} ({3}) · {9}"
    },
    { "type": "localip", "key": "╰─   IP", "keyColor": "cyan" },

    "break",
  ]
}
